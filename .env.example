# Configuração de Ambiente para Desenvolvimento

# Supabase
VITE_SUPABASE_URL="https://olrtzxamixygmrftcczc.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_publica_anon_aqui"
SUPABASE_URL="https://olrtzxamixygmrftcczc.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua_chave_publica_aqui"
SUPABASE_SECRET_KEY="sua_chave_secreta_aqui"

# Gemini AI API Key
GEMINI_API_KEY=""

# Host URL
APP_URL="http://localhost:3000"
PORT=3000

# ==============================================================
# MOTOR DE ALERTAS POR E-MAIL (escolha UM provedor)
# ==============================================================
# Remetente exibido nos alertas
EMAIL_FROM="SESMT Busato <alertas@suaempresa.com.br>"
# Opcional: força o provedor (smtp | resend). Se vazio, é detectado automaticamente.
EMAIL_PROVIDER=""
# Destinatários extras sempre autorizados (separados por vírgula)
ALERT_RECIPIENTS=""

# --- Opção A: SMTP (qualquer provedor) ---
# Microsoft 365/Outlook: smtp.office365.com : 587
# Zoho: smtp.zoho.com : 465 (SMTP_SECURE=true)
# Hostinger: smtp.hostinger.com : 465 | Locaweb: email-ssl.com.br : 465
# Brevo: smtp-relay.brevo.com : 587 | Gmail: smtp.gmail.com : 465 (senha de app)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# --- Opção B: Resend (API HTTP - https://resend.com) ---
RESEND_API_KEY=""
